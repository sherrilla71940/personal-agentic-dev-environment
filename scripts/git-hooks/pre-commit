#!/usr/bin/env bash
# Validate the staged chezmoi source state before it can be committed.
#
# This is deliberately non-destructive: it renders into a temporary directory and never
# touches the home directory. It catches template failures and chezmoi filename-attribute
# collisions that are not obvious in a normal Git diff.
#
# Enabled once per clone by scripts/bootstrap/bootstrap-*, or by hand:
#   git config core.hooksPath scripts/git-hooks
set -euo pipefail

repo="$(git rev-parse --show-toplevel)"
cd "$repo" || exit 1

fail() { printf 'pre-commit: %s\n' "$1" >&2; exit 1; }

frontmatter_has() {
  local file="$1"
  local pattern="$2"

  awk '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter { print }
  ' "$file" | grep -Eq "$pattern"
}

# Shared-index guard. Git commits the index, not the paths a session meant to stage, and this
# folder's index is shared by every process working in it -- git only refuses a duplicate
# checkout across worktrees, never across processes. A staged change also outlives the session
# that made it, so detecting live sessions cannot catch the case that actually loses work: a
# session stages a path, exits, and the next commit here absorbs it under an unrelated message.
# The listing below is therefore unconditional. It needs no provenance, which git does not
# record, and makes a mixed commit visible at the moment it is made.
staged_paths="$(git diff --cached --name-only)"
staged_count="$(printf '%s' "$staged_paths" | grep -c . || true)"
if [[ "$staged_count" -gt 0 ]]; then
  printf 'pre-commit: committing %s staged path(s):
' "$staged_count" >&2
  printf '%s
' "$staged_paths" | sed 's/^/      /' >&2
  printf '    Not all yours? Cancel, then commit only what you meant:
' >&2
  printf '      git commit --only -m "<message>" -- <path>...
' >&2
fi

# Escalate when another session is live in this tree, because then the index can gain a path
# between staging and committing, not merely hold one from earlier.
if command -v claude >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
  sessions="$(timeout 5 claude agents --json 2>/dev/null || true)"
  if [[ -n "$sessions" ]]; then
    # Drive-letter case and separator style vary between the agent listing and git's path on
    # Windows, so compare normalised paths. A session in a subdirectory shares the same index,
    # so match the repository prefix rather than an exact directory.
    sharing="$(printf '%s' "$sessions" | jq -r --arg repo "$repo" '
      def norm: ascii_downcase | gsub("\\\\"; "/") | sub("/$"; "");
      [ .[]
        | select(.kind == "interactive")
        | select(((((.cwd // "") | norm) + "/") | startswith(($repo | norm) + "/")))
      ] | length
    ' 2>/dev/null || printf '0')"

    # A git hook receives no session identity, so the committing session counts itself here.
    # Two or more means another session is working in this index right now.
    if [[ "$sharing" =~ ^[0-9]+$ ]] && (( sharing > 1 )); then
      printf 'pre-commit: %s interactive Claude Code sessions share this working tree,
'         "$sharing" >&2
      printf '    so the staged set above can change under you. Prefer --only here.
' >&2
    fi
  fi
fi

# Chezmoi may not yet be on Git Bash's PATH after a Winget installation.
chezmoi_bin="$(command -v chezmoi || true)"
if [[ -z "$chezmoi_bin" && -n "${LOCALAPPDATA:-}" ]]; then
  local_app_data="$LOCALAPPDATA"
  if command -v cygpath >/dev/null 2>&1; then
    local_app_data="$(cygpath -u "$local_app_data")"
  elif [[ "$local_app_data" =~ ^([A-Za-z]):\\(.*)$ ]]; then
    local_app_data="/${BASH_REMATCH[1],,}/${BASH_REMATCH[2]//\\//}"
  fi
  for candidate in "${local_app_data}/Microsoft/WinGet/Packages/twpayne.chezmoi"*/chezmoi.exe; do
    [[ -x "$candidate" ]] && { chezmoi_bin="$candidate"; break; }
  done
fi
if [[ -z "$chezmoi_bin" ]]; then
  printf 'pre-commit: chezmoi not found; skipping source-state validation.\n' >&2
  exit 0
fi

# A plain chezmoi apply uses the default source regardless of the current directory. Refuse
# commits while it points at a different clone, because the committed changes would not apply.
source_path="$($chezmoi_bin source-path 2>/dev/null || true)"
[[ -d "$source_path" ]] || fail "default chezmoi source path is unavailable: $source_path"

repo_real="$(cd "$repo" && pwd -P)"
source_real="$(cd "$source_path" && pwd -P)"
case "$source_real/" in
  "$repo_real/"*) ;;
  *) fail "default chezmoi source is outside this repository: $source_path
    Reconcile the source directory before committing or applying changes." ;;
esac

work="$(mktemp -d)"
staged="$work/source"
render="$work/render"
mkdir -p "$staged" "$render"
trap 'rm -rf "$work"' EXIT

# Validate exactly what the commit would contain, not unrelated unstaged working-tree changes.
git checkout-index --all --prefix="$staged/" || fail "could not materialize the staged snapshot."

# 1. The source state must render. --exclude=scripts excludes chezmoi script entry types, so
#    validation can never execute a managed script.
if ! "$chezmoi_bin" apply --source="$staged" --destination="$render" \
       --exclude=scripts --no-tty --force >"$render/.log" 2>&1; then
  printf 'pre-commit: the staged source state failed to render.\n' >&2
  sed 's/^/    /' "$render/.log" >&2
  exit 1
fi

# 2. Every skill file must survive chezmoi's filename transformations. Source dotfiles are
#    ignored by design, so exclude them from the count rather than treating them as loss.
skills_dir="$staged/home/dot_agents/skills"
[[ -d "$skills_dir" ]] || fail "staged source is missing home/dot_agents/skills."
src_skills=$(find "$skills_dir" -type f ! -name '.*' | wc -l)
out_skills=$(find "$render/.agents/skills" -type f 2>/dev/null | wc -l)
if [[ "$src_skills" -ne "$out_skills" ]]; then
  fail "skill file count changed on render: $src_skills in source, $out_skills rendered.
    A filename probably collided with a chezmoi attribute prefix (create_, run_, symlink_,
    empty_, dot_ ...). See docs/chezmoi-workflow.md, 'Source filename rules'."
fi

# 3. Every portable skill must render as an individual Claude symlink. A source-only
#    .codex-only marker instead requires host gates that keep Claude and Copilot from
#    automatically loading a Codex-targeted skill. Codex's invocation policy is explicit in the
#    metadata: side-effectful skills use false, while a deliberately safe on-demand skill may use
#    true.
for src in "$staged"/home/dot_agents/skills/*; do
  [[ -d "$src" ]] || continue
  name="$(basename "$src")"
  link_src="$staged/home/dot_claude/skills/symlink_$name.tmpl"
  link_out="$render/.claude/skills/$name"

  if [[ -f "$src/.codex-only" ]]; then
    [[ ! -e "$link_src" ]] ||
      fail "Codex-targeted skill '$name' must not have a Claude symlink template."
    [[ -f "$src/SKILL.md" ]] || fail "Codex-targeted skill '$name' is missing SKILL.md."
    frontmatter_has "$src/SKILL.md" \
      '^disable-model-invocation:[[:space:]]*true[[:space:]]*$' ||
      fail "Codex-targeted skill '$name' must disable Copilot model invocation in SKILL.md."
    openai_metadata="$src/agents/openai.yaml"
    [[ -f "$openai_metadata" ]] ||
      fail "Codex-targeted skill '$name' is missing agents/openai.yaml."
    grep -Eq '^[[:space:]]*allow_implicit_invocation:[[:space:]]*(true|false)[[:space:]]*$' \
      "$openai_metadata" ||
      fail "Codex-targeted skill '$name' must declare Codex implicit invocation policy."
    continue
  fi

  [[ -f "$link_src" ]] || fail "shared skill '$name' has no Claude symlink template."
  [[ -L "$link_out" ]] || fail "shared skill '$name' did not render as a Claude symlink."
  target="$(readlink "$link_out")"
  [[ "$target" == */.agents/skills/"$name" ]] ||
    fail "shared skill '$name' rendered with an unexpected Claude symlink target: $target"
done

# 4. Every shared rule must render with identical Claude and Copilot bodies. cmp is available
#    in Git Bash and standard macOS, unlike md5sum.
for src in "$staged"/home/.chezmoitemplates/rules/*.md; do
  name="$(basename "$src" .md)"
  claude="$render/.claude/rules/$name.md"
  copilot="$render/.copilot/instructions/$name.instructions.md"
  [[ -f "$claude" ]] || fail "shared rule '$name' has no Claude template."
  [[ -f "$copilot" ]] || fail "shared rule '$name' has no Copilot template."

  claude_body="$work/$name.claude.md"
  copilot_body="$work/$name.copilot.md"
  sed '1,/^---$/d;1,/^---$/d' "$claude" >"$claude_body"
  sed '1,/^---$/d;1,/^---$/d' "$copilot" >"$copilot_body"
  cmp -s "$claude_body" "$copilot_body" ||
    fail "shared rule '$name' renders different bodies for Claude and Copilot."
done

# 5. Codex must receive a literal AGENTS.md without YAML frontmatter.
if head -1 "$render/.codex/AGENTS.md" | grep -q '^---$'; then
  fail "~/.codex/AGENTS.md starts with YAML frontmatter. Codex renders it as visible text
    and it counts against project_doc_max_bytes. Keep .chezmoitemplates/core.md frontmatter-free."
fi

# 6. The two status line copies must render identical text. They are separate
#    implementations of one output, and nothing else would catch a change made to one
#    and not the other. Only run when they change: PowerShell start-up costs a few
#    seconds and would otherwise be charged to every commit.
statusline_changed=false
while IFS= read -r changed; do
  case "$changed" in
    home/dot_claude/claude-session-statusline.*) statusline_changed=true ;;
  esac
done < <(git diff --cached --name-only)

if [[ "$statusline_changed" == true ]]; then
  statusline_sh="$render/.claude/claude-session-statusline.sh"
  statusline_ps1="$render/.claude/claude-session-statusline.ps1"
  powershell_bin="$(command -v powershell.exe || command -v pwsh || true)"

  if [[ -z "$powershell_bin" ]]; then
    printf 'pre-commit: no PowerShell available; skipping status line parity check.\n' >&2
  elif ! command -v jq >/dev/null 2>&1; then
    printf 'pre-commit: jq is unavailable; skipping status line parity check.\n' >&2
  else
    # Reset times four days out render as a weekday rather than a clock time, so the
    # two runs cannot disagree because a minute ticked over between them.
    far_reset=$(( $(date +%s) + 4 * 86400 ))
    fixtures=(
      "$(printf '{"model":{"display_name":"Opus 5"},"effort":{"level":"high"},"session_name":"parity fixture","workspace":{"current_dir":"%s"},"context_window":{"used_percentage":29},"cost":{"total_cost_usd":25.04},"rate_limits":{"five_hour":{"used_percentage":64,"resets_at":%s},"seven_day":{"used_percentage":8,"resets_at":%s}}}' "$repo" "$far_reset" "$far_reset")"
      '{"model":{"display_name":"Opus 5"},"session_name":"中文狀態列測試"}'
      '{"model":{"display_name":"Opus 5"}}'
    )

    # Both widths are exercised, because the layout is width-dependent: a change applied to
    # only one copy's compact branch is invisible at the default width.
    widths=(80 40)
    comparisons=0

    for width in "${widths[@]}"; do
      for fixture in "${fixtures[@]}"; do
        sh_output="$(printf '%s' "$fixture" | COLUMNS="$width" bash "$statusline_sh" 2>/dev/null || true)"
        # PowerShell writes CRLF where bash writes LF; the host trims either, so compare
        # the text rather than the exact bytes.
        ps_output="$(printf '%s' "$fixture" |
          COLUMNS="$width" "$powershell_bin" -NoProfile -ExecutionPolicy Bypass -File "$statusline_ps1" 2>/dev/null |
          tr -d '\r' || true)"
        comparisons=$((comparisons + 1))

        if [[ "$sh_output" != "$ps_output" ]]; then
          printf 'pre-commit: the status line copies disagree at COLUMNS=%s.\n' "$width" >&2
          printf '    bash: %s\n' "$sh_output" >&2
          printf '    ps1 : %s\n' "$ps_output" >&2
          fail "keep home/dot_claude/claude-session-statusline.sh and .ps1 in step."
        fi
      done
    done

    printf 'pre-commit: status line copies agree (%s comparisons).\n' "$comparisons"
  fi
fi

# 7. Every relative markdown link must resolve: the file it names must exist, and a #fragment
#    must match a real heading, in another file or in the same one. Both failures are silent --
#    the link still renders and only fails when a reader clicks it. The guides and the decision
#    records cross-reference each other both ways, so one renamed heading or one moved file can
#    break several files at once. Only run when markdown is staged.
docs_changed=false
while IFS= read -r changed; do
  case "$changed" in *.md) docs_changed=true ;; esac
done < <(git diff --cached --name-only)

if [[ "$docs_changed" == true ]]; then
  anchor_awk="$staged/scripts/git-hooks/markdown-anchors.awk"
  if [[ ! -f "$anchor_awk" ]]; then
    printf 'pre-commit: markdown-anchors.awk is missing; skipping the link check.\n' >&2
  else
    mapfile -t md_files < <(cd "$staged" && find . -type f -name '*.md' | sed 's|^\./||')
    if anchor_out="$(cd "$staged" && awk -f "$anchor_awk" "${md_files[@]}" 2>&1)"; then
      printf 'pre-commit: markdown links OK (%s checked).\n' "$anchor_out"
    else
      printf 'pre-commit: markdown links name files or headings that do not exist.\n' >&2
      printf '%s\n' "$anchor_out" >&2
      fail "fix the links above, or restore what they name."
    fi
  fi
fi

printf 'pre-commit: staged source state OK (%s skill files, %s shared rules).\n' \
  "$src_skills" "$(find "$staged/home/.chezmoitemplates/rules" -maxdepth 1 -type f -name '*.md' | wc -l)"
