{{- /* Codex lifecycle hooks. Codex CLI supports the same events, payload fields and output
       contract as Claude Code, so the continuity hook is the same script for both clients:
       it names no client machinery and reads only hook_event_name, cwd and source.

       This file is user-authored configuration. Codex records hook *trust* separately, in
       config.toml under [hooks.state] keyed by this path plus a sha256, so managing this file
       does not fight the app for ownership - but each entry needs one `/hooks` approval per
       machine, and editing an entry invalidates its approval.

       Native harness mode renders the lightweight notification entry but no continuity
       lifecycle entries. Managed mode adds those lifecycle entries according to the profile.
       Claude's equivalent wiring lives in home/.chezmoitemplates/claude/settings-durable.json. */ -}}

{{- $isWindows := eq .chezmoi.os "windows" -}}
{{- $profile := includeTemplate "ai-profile.yaml" . | fromYaml -}}
{{- $isManaged := eq $profile.ai_harness "managed" -}}
{{- $continuityEnabled := and $isManaged (eq $profile.ai_continuity "on") -}}
{{- $pwsh := "powershell.exe -NoProfile -ExecutionPolicy Bypass -File" -}}
{{- $gitBash := printf "%s/AppData/Local/Programs/Git/bin/bash.exe" .chezmoi.homeDir | replace "/" "\\" -}}

{{- $continuityCommand := "bash \"$HOME/.local/share/maintain-project-continuity.sh\"" -}}
{{- $notifyCommand := "" -}}
{{- if $isWindows -}}
{{-   $continuityCommand = printf "\"%s\" \"$HOME/.local/share/maintain-project-continuity.sh\"" $gitBash -}}
{{-   $notifyCommand = printf "%s \"$HOME/.local/share/show-agent-notification.ps1\"" $pwsh -}}
{{- else -}}
{{-   $notifyCommand = "bash \"$HOME/.local/share/show-agent-notification-macos.sh\"" -}}
{{- end -}}
{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": {{ $notifyCommand | toJson }}, "timeout": 20 }
        ]
      }
    ]{{ if $continuityEnabled }},
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": {{ $continuityCommand | toJson }}, "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": {{ $continuityCommand | toJson }}, "timeout": 5 }
        ]
      }
    ]
    {{- end }}
  }
}
